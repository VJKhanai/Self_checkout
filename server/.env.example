PORT=5001
NODE_ENV=development
# Local MongoDB default for development:
MONGO_URI=mongodb://127.0.0.1:27017/self_checkout
# Atlas example: mongodb+srv://<user>:<pass>@cluster0.mongodb.net/self_checkout
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=7d
EXIT_TOKEN_SECRET=change_me_exit_qr_secret
EXIT_TOKEN_TTL_MINUTES=120
# OTP provider: mock | twilio | firebase
OTP_PROVIDER=mock
MOCK_OTP=123456
# Firebase Phone Auth configuration (recommended free option)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional Twilio fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SERVICE_SID=
# Simulated payment gateway (Razorpay-shaped, no real money)
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=mock_key_id
PAYMENT_KEY_SECRET=mock_key_secret
AUDIT_RATE=0.1
